<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_caldav_sync_config_own" model="ir.rule">
        <field name="name">CalDAV connections: own connection</field>
        <field name="model_id" ref="model_caldav_sync_config"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_caldav_sync_config_system_all" model="ir.rule">
        <field name="name">CalDAV connections: administrators</field>
        <field name="model_id" ref="model_caldav_sync_config"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
